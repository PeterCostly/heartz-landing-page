---
---
<section id="privacy" class="section" aria-labelledby="privacy-title">
  <div class="container">
    <div class="library-layout">
      <!-- Description -->
      <div class="library-content">
        <span class="section-tag">Private By Design</span>
        <h2 id="privacy-title" class="section-headline">
          100% Private. Runs on your device.
        </h2>
        <p class="section-intro" style="text-align: left; margin-bottom: 1.5rem;">
          0 tracking, 0 cloud storage of your audio files, 0 servers analyzing what you listen to. Everything stays strictly on your computer or phone.
        </p>
        
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.9rem; margin-bottom: 2rem;">
          <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <div style="color: var(--color-brand-peach); font-weight: 700;">✓</div>
            <div>
              <strong style="color: var(--text-primary); font-size: 0.9375rem;">0 cloud uploads</strong>
              <p style="color: var(--text-muted); font-size: 0.875rem;">Even full songs are converted directly in your browser’s local memory.</p>
            </div>
          </li>
          <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <div style="color: var(--color-brand-peach); font-weight: 700;">✓</div>
            <div>
              <strong style="color: var(--text-primary); font-size: 0.9375rem;">Presets saved locally</strong>
              <p style="color: var(--text-muted); font-size: 0.875rem;">Your favorite settings are stored right in your browser (IndexedDB) with instant recall.</p>
            </div>
          </li>
          <li style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <div style="color: var(--color-brand-peach); font-weight: 700;">✓</div>
            <div>
              <strong style="color: var(--text-primary); font-size: 0.9375rem;">Export anytime</strong>
              <p style="color: var(--text-muted); font-size: 0.875rem;">Back up or move your custom frequency presets as clean JSON files.</p>
            </div>
          </li>
        </ul>

        <a href="https://heartz.pk-1ca.workers.dev/" class="btn btn-secondary" rel="noopener noreferrer">
          <span>Open HEARTz in Browser</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Terminal / Storage Mockup -->
      <div class="library-terminal-card" role="region" aria-label="Local storage visualization">
        <div class="terminal-header">
          <div class="terminal-dots" aria-hidden="true">
            <div class="terminal-dot"></div>
            <div class="terminal-dot"></div>
            <div class="terminal-dot"></div>
          </div>
          <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-brand-peach);">
            IndexedDB // Local Storage
          </span>
          <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);">
            STATUS: ACTIVE
          </span>
        </div>

        <div class="library-item-row">
          <div>
            <div class="library-item-title">Deep Ground 432 Hz</div>
            <div class="library-item-desc">Pure 432 Hz tone + Brown Noise</div>
          </div>
          <span class="library-item-badge">PRESET</span>
        </div>

        <div class="library-item-row">
          <div>
            <div class="library-item-title">Ocean Waves 7.83 Hz</div>
            <div class="library-item-desc">Schumann Resonance + Binaural Waves</div>
          </div>
          <span class="library-item-badge">BINAURAL</span>
        </div>

        <div class="library-item-row">
          <div>
            <div class="library-item-title">Soft Focus 528 Hz</div>
            <div class="library-item-desc">528 Hz Carrier + Pink Noise</div>
          </div>
          <span class="library-item-badge">FOCUS</span>
        </div>

        <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px dashed var(--border-subtle); display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);">
          <span>Cloud Tracking: 0 (100% Private)</span>
          <span style="color: var(--color-brand-peach);">● Local Only</span>
        </div>
      </div>
    </div>
  </div>
</section>
