---
const FAQ_ITEMS = [
  {
    q: "What makes 432 Hz different from standard 440 Hz?",
    a: "Standard music is tuned to A4 = 440 Hz. A 432 Hz tuning is slightly lower and warmer. Many listeners, musicians, and creators find it softer, more organic, and noticeably less tiring for extended focus or relaxation sessions."
  },
  {
    q: "Do I need headphones to use this?",
    a: "For pure frequencies, relaxing noises, and retuned music, standard speakers or earbuds sound great. For <strong>binaural beats</strong> (like our ocean wave session), stereo headphones are required so each ear receives a slightly different frequency."
  },
  {
    q: "Why do you recommend starting at low volume?",
    a: "Pure sound waves carry concentrated acoustic energy, even when they feel gentle. Starting at 20–30% volume protects your hearing and lets your ears ease into the sound comfortably."
  },
  {
    q: "Is HEARTz free and private?",
    a: "Yes. HEARTz runs 100% in your browser. There are no signups, subscriptions, or ads. Your audio files and music never leave your device."
  }
];
---
<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container">
    <div class="section-head">
      <span class="section-tag">Questions & Answers</span>
      <h2 id="faq-title" class="section-headline">
        Frequently Asked Questions
      </h2>
      <p class="section-intro">
        Everything you need to know before your first listening session.
      </p>
    </div>

    <div class="faq-stack" role="region" aria-label="Frequently Asked Questions">
      {FAQ_ITEMS.map((item, idx) => (
        <details class="faq-card" open={idx === 0}>
          <summary class="faq-header">
            <span>{item.q}</span>
            <svg class="faq-icon-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="faq-body" set:html={item.a}></div>
        </details>
      ))}
    </div>
  </div>
</section>
