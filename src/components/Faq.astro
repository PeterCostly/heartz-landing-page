---
import { FAQ_ITEMS } from "../data/faq";
---
<section id="faq" class="section section-light" aria-labelledby="faq-title">
  <div class="container">
    <div class="section-head">
      <span class="section-tag">Questions & Answers</span>
      <h2 id="faq-title" class="section-headline">
        Frequently Asked Questions
      </h2>
      <p class="section-intro">
        Everything you need to know before your first listening session.
      </p>
    </div>

    <div class="faq-stack" role="region" aria-label="Frequently Asked Questions">
      {FAQ_ITEMS.map((item, idx) => (
        <details class="faq-card" open={idx === 0}>
          <summary class="faq-header">
            <span>{item.q}</span>
            <svg class="faq-icon-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="faq-body" set:html={item.a}></div>
        </details>
      ))}
    </div>
  </div>
</section>
