---
---
<section id="start" class="hero-centered" aria-labelledby="hero-title">
  <div class="container hero-centered-content">
    <div class="hero-pill-badge">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span>Free in your browser · Instant email login</span>
    </div>

    <h1 id="hero-title" class="hero-headline">
      Sound that feels like <span class="highlight">frequency, not noise.</span>
    </h1>

    <p class="hero-subhead">
      Play grounding focus frequencies, calming binaural brown noise, or retune any song to 432 Hz in 3 seconds. 100% private in your browser.
    </p>

    <div class="hero-cta-group">
      <a href="https://heartz.pk-1ca.workers.dev/" class="btn btn-primary" rel="noopener noreferrer">
        <span>Launch HEARTz (Free)</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a href="#demo-player" id="hero-scroll-player-btn" class="btn btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>Listen to sample ↓</span>
      </a>
    </div>

    <div class="hero-meta-label">
      <span style="color: var(--color-brand-peach);">✓</span>
      <span>🎧 Headphones recommended for binaural audio · 0 ads · 100% In-Browser</span>
    </div>
  </div>
</section>
