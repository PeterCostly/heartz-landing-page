---
import { getAppUrl } from "../config/appLinks";
---
<header class="site-header">
  <div class="container header-inner">
    <a href="#start" class="brand-mark" aria-label="Heartz - Pure Sound">
      <img 
        src="/brand/heartz-sygnet.png" 
        alt="" 
        class="brand-sygnet-icon" 
        width="1254" 
        height="1254" 
        loading="eager"
        decoding="async"
      />
      <span class="brand-text">Heartz</span>
    </a>

    <nav aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="#features">Features</a></li>
        <li><a href="#how-it-works">How It Works</a></li>
        <li><a href="#privacy">Privacy</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href={getAppUrl("home")} class="btn btn-primary" rel="noopener noreferrer">
        <span>Open HEARTz</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>
</header>
