---
---
<section id="how-it-works" class="section section-light" aria-labelledby="flow-title">
  <div class="container">
    <div class="section-head">
      <span class="section-tag">How It Works</span>
      <h2 id="flow-title" class="section-headline">
        From first sound to your own setup
      </h2>
      <p class="section-intro">
        Create a free account, choose a sound and adjust it in your browser.
      </p>
    </div>

    <div class="signal-flow-grid">
      <!-- Step 1 -->
      <div class="flow-card">
        <div class="flow-step-number" aria-hidden="true">01</div>
        <h3>Pick your sound</h3>
        <p>
          Choose a ready-to-play session, dial in a custom frequency, or import a supported audio file to retune.
        </p>
        <div class="flow-hint">Email or Google sign-in</div>
      </div>

      <!-- Step 2 -->
      <div class="flow-card">
        <div class="flow-step-number" aria-hidden="true">02</div>
        <h3>Set your level</h3>
        <p>
          Start at a comfortable low volume. Use stereo headphones to hear the intended binaural difference.
        </p>
        <div class="flow-hint">Smooth, click-free fades</div>
      </div>

      <!-- Step 3 -->
      <div class="flow-card">
        <div class="flow-step-number" aria-hidden="true">03</div>
        <h3>Listen or keep</h3>
        <p>
          Listen in your browser or export an uncompressed WAV file where available.
        </p>
        <div class="flow-hint">Studio-quality WAV export</div>
      </div>
    </div>
  </div>
</section>
