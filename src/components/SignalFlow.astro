---
---
<section id="how-it-works" class="section" aria-labelledby="flow-title">
  <div class="container">
    <div class="section-head">
      <span class="section-tag">How It Works</span>
      <h2 id="flow-title" class="section-headline">
        Start listening in three seconds
      </h2>
      <p class="section-intro">
        No signups, no subscriptions, no ads. Just pure sound right in your browser.
      </p>
    </div>

    <div class="signal-flow-grid">
      <!-- Step 1 -->
      <div class="flow-card">
        <div class="flow-step-number" aria-hidden="true">01</div>
        <h3>Pick your sound</h3>
        <p>
          Choose a ready-to-play session, dial in a custom frequency, or drop in any audio file to retune to 432 Hz.
        </p>
        <div class="flow-hint">No account required</div>
      </div>

      <!-- Step 2 -->
      <div class="flow-card">
        <div class="flow-step-number" aria-hidden="true">02</div>
        <h3>Set your level</h3>
        <p>
          Start at a comfortable low volume (20–30%). Put on stereo headphones if you're listening to binaural beats.
        </p>
        <div class="flow-hint">Smooth, click-free fades</div>
      </div>

      <!-- Step 3 -->
      <div class="flow-card">
        <div class="flow-step-number" aria-hidden="true">03</div>
        <h3>Listen or keep</h3>
        <p>
          Enjoy unlimited playback in your browser, or export uncompressed WAV files to listen anywhere offline.
        </p>
        <div class="flow-hint">Studio-quality WAV export</div>
      </div>
    </div>
  </div>
</section>
