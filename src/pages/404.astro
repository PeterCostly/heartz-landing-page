---
import "../styles/global.css";
import Header from "../components/Header.astro";
import ContactFooter from "../components/ContactFooter.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    
    <title>404 — Frequency Not Found | HEARTz</title>
    <meta 
      name="description" 
      content="The requested frequency or page could not be located. Return to the HEARTz sound generator." 
    />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href="/brand/heartz-app-icon.png" />
    <link rel="apple-touch-icon" href="/brand/heartz-app-icon.png" />
    <meta name="theme-color" content="#2C0515" />

    <!-- Google Fonts: Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    </noscript>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Header />

    <main id="main-content" class="container" style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: clamp(4rem, 10vw, 8rem) 1.5rem;">
      <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-brand-peach); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 1rem;">
        Error 404 // Wave Desynchronized
      </div>

      <h1 style="font-size: clamp(2.5rem, 6vw, 4.2rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 1.25rem;">
        Frequency Not Found
      </h1>

      <p style="max-width: 520px; color: var(--text-muted); font-size: 1.1rem; line-height: 1.6; margin-bottom: 2.5rem;">
        The harmonic channel or session URL you are looking for does not exist or has been shifted.
      </p>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
        <a href="/" class="btn btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Return to Home</span>
        </a>

        <a href="https://heartz.pk-1ca.workers.dev/" class="btn btn-secondary" rel="noopener noreferrer">
          <span>Launch HEARTz App</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <div>
          <p>© 2026 <strong>HEARTz</strong>. All rights reserved.</p>
        </div>
        <div style="font-size: 0.8125rem; font-family: var(--font-mono); color: var(--text-muted);">
          <a href="/" style="color: var(--color-brand-peach); text-decoration: none;">HEARTz Pure Audio</a>
        </div>
      </div>
    </footer>
  </body>
</html>
