---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AudioConsole from "../components/AudioConsole.astro";
import FeaturesStudio from "../components/FeaturesStudio.astro";
import SignalFlow from "../components/SignalFlow.astro";
import LibraryShowcase from "../components/LibraryShowcase.astro";
import ArchitecturePrivacy from "../components/ArchitecturePrivacy.astro";
import Faq from "../components/Faq.astro";
import ContactFooter from "../components/ContactFooter.astro";
import PostHog from "../components/PostHog.astro";
import { FAQ_ITEMS } from "../data/faq";
import { getAppUrl } from "../config/appLinks";

// Production canonical URL is configuration-driven via SITE environment variable
const siteUrl = import.meta.env.SITE;
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const ogImageUrl = siteUrl ? new URL("/og-image.png?v=2", siteUrl).href : "/og-image.png?v=2";
const logoUrl = siteUrl ? new URL("/logo.png", siteUrl).href : "/logo.png";
const appHomeUrl = getAppUrl("home");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <title>HEARTz — Explore Sound, Frequencies & 432 Hz Audio</title>
    <meta 
      name="description" 
      content="Explore pure frequencies, binaural sound and guided sessions. Retune supported audio from 440 to 432 Hz with local browser processing." 
    />
    <meta name="keywords" content="432 hz converter, frequency lab, binaural beats, brown noise, soundscapes, audio retuning, pure tones, web audio api, 528 hz, private audio generator" />
    <meta name="author" content="HEARTz" />
    <meta name="application-name" content="HEARTz" />
    <meta name="apple-mobile-web-app-title" content="HEARTz" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" hreflang="en" href={canonicalUrl || "https://heartz.app/"} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl || "https://heartz.app/"} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href="/brand/heartz-app-icon.png" />
    <link rel="apple-touch-icon" href="/brand/heartz-app-icon.png" />
    <meta name="theme-color" content="#2C0515" />

    <!-- Open Graph & Social -->
    <meta property="og:site_name" content="HEARTz" />
    <meta property="og:title" content="HEARTz — Explore Sound, Frequencies & 432 Hz Audio" />
    <meta property="og:description" content="Explore pure frequencies, binaural sound and guided sessions. Retune supported audio from 440 to 432 Hz with local browser processing." />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HEARTz — Explore Sound, Frequencies & 432 Hz Audio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HEARTz — Explore Sound, Frequencies & 432 Hz Audio" />
    <meta name="twitter:description" content="Explore pure frequencies, binaural sound and guided sessions. Retune supported audio from 440 to 432 Hz with local browser processing." />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="HEARTz Sound Generator & 432 Hz Converter" />

    <!-- Google Fonts: Manrope (Official HEARTz Brand Font, non-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    </noscript>

    <!-- Schema.org JSON-LD (Semantic structured data for HEARTz) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebApplication",
          "name": "HEARTz",
          "url": appHomeUrl,
          "applicationCategory": "MultimediaApplication",
          "operatingSystem": "All",
          "browserRequirements": "Requires modern browser with Web Audio API support",
          "description": "Explore pure frequencies, binaural sound and guided sessions. Retune supported audio from 440 to 432 Hz in your browser.",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock"
          },
          "featureList": [
            "440 to 432 Hz audio converter (WAV/FLAC)",
            "Procedural noise generator with tone layers",
            "Tone generator with 0.01 Hz control resolution",
            "Configurable binaural differences",
            "Uncompressed WAV export",
            "Local browser audio processing"
          ]
        },
        {
          "@type": "WebSite",
          "name": "HEARTz",
          "url": siteUrl || "https://heartz.app/",
          "description": "In-browser sound generator, binaural soundscapes, and 432 Hz audio converter.",
          "inLanguage": "en"
        },
        {
          "@type": "Organization",
          "name": "HEARTz",
          "url": siteUrl || appHomeUrl,
          "logo": logoUrl,
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "Customer Support",
            "email": "contact@aitificer.com"
          }
        },
        {
          "@type": "AudioObject",
          "name": "Brown Noise Layered with 432 Hz Tone (Sample)",
          "description": "Procedural brown noise sample layered with a 432 Hz tone.",
          "contentUrl": (siteUrl || "https://heartz.app") + "/audio/deep_ground_10s.wav",
          "encodingFormat": "audio/wav",
          "duration": "PT10S"
        },
        {
          "@type": "AudioObject",
          "name": "Soft Focus 528 Hz (Sample)",
          "description": "528 Hz pure tone sample with subtle amplitude modulation and soft pink noise.",
          "contentUrl": (siteUrl || "https://heartz.app") + "/audio/soft_focus_10s.wav",
          "encodingFormat": "audio/wav",
          "duration": "PT10S"
        },
        {
          "@type": "AudioObject",
          "name": "432 Hz Audio Converter Preview (Sample)",
          "description": "Audio preview retuned from 440 Hz reference to 432 Hz reference via natural resampling.",
          "contentUrl": (siteUrl || "https://heartz.app") + "/audio/converter_432hz_retuned_preview.wav",
          "encodingFormat": "audio/wav",
          "duration": "PT3.06S"
        },
        {
          "@type": "FAQPage",
          "mainEntity": FAQ_ITEMS.map((item) => ({
            "@type": "Question",
            "name": item.q,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": item.plainText || item.a.replace(/<[^>]+>/g, '')
            }
          }))
        }
      ]
    })} />
    <PostHog />
  </head>
  <body>
    <a href="#start" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content">
      <Hero />
      <AudioConsole />
      <FeaturesStudio />
      <SignalFlow />
      <LibraryShowcase />
      <ArchitecturePrivacy />
      <Faq />
      <ContactFooter />
    </main>
  </body>
</html>
