---
import "../styles/global.css";
import Header from "../components/Header.astro";
import ContactFooter from "../components/ContactFooter.astro";
import { getAppUrl } from "../config/appLinks";

const siteUrl = import.meta.env.SITE || "https://heartz.app";
const canonicalUrl = new URL("/privacy", siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    
    <title>Data & Privacy — HEARTz</title>
    <meta 
      name="description" 
      content="How HEARTz handles your account, local settings and audio files."
    />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href="/brand/heartz-app-icon.png" />
    <link rel="apple-touch-icon" href="/brand/heartz-app-icon.png" />
    <meta name="theme-color" content="#2C0515" />

    <!-- Google Fonts: Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />
    </noscript>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <Header />

    <main id="main-content" class="container" style="flex: 1; padding: clamp(3rem, 6vw, 5rem) 1.5rem; max-width: 860px; margin: 0 auto;">
      <div style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-brand-peach); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.75rem;">
        HEARTz // Data & Privacy
      </div>

      <h1 style="font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem; color: var(--text-primary); line-height: 1.15;">
        How HEARTz Handles Your Data
      </h1>

      <div style="display: flex; gap: 1.5rem; color: var(--text-muted); font-size: 0.875rem; font-family: var(--font-mono); margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1.25rem; flex-wrap: wrap;">
        <span>Updated: September 2026</span>
        <span>·</span>
        <span>Version 1.0</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 2.5rem; color: var(--text-primary); line-height: 1.7; font-size: 1.025rem;">
        
        <!-- Summary callout -->
        <div style="background: var(--bg-surface-glass); border: 1px solid var(--border-card); border-radius: var(--radius-md); padding: 1.5rem 1.75rem;">
          <h2 style="font-size: 1.15rem; font-weight: 600; color: var(--color-brand-peach); margin-bottom: 0.5rem;">
            Your files stay on your device
          </h2>
          <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">
            HEARTz processes audio files you choose in your browser. Those files are not uploaded to HEARTz servers. Firebase Authentication handles your account, while saved settings and library entries currently stay in this browser.
          </p>
        </div>

        <!-- 1. Zero-Upload Audio Architecture -->
        <section>
          <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-brand-cream);">
            1. Local Audio Processing
          </h2>
          <p style="margin-bottom: 0.75rem; color: var(--text-muted);">
            All audio generation, synthesis (pure sine/triangle waves, binaural sound, isochronic tones, 432 Hz retuning), and file decoding happen entirely within your web browser using client-side Web Audio API and WebAssembly.
          </p>
          <ul style="padding-left: 1.5rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li><strong>Audio files remain on your device:</strong> When you select or retune a music track, it is decoded in your local device RAM. We do not store or transmit your audio files to our servers.</li>
            <li><strong>No server-side audio analysis:</strong> The Converter analyzes your selected file locally to prepare its preview and export; HEARTz does not send that file to a server for analysis.</li>
          </ul>
        </section>

        <!-- 2. What Information We Collect -->
        <section>
          <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-brand-cream);">
            2. Information We Collect & Authentication
          </h2>
          <p style="margin-bottom: 0.75rem; color: var(--text-muted);">
            An account is required to enter the application. Firebase Authentication manages sign-in; cloud synchronization of your saved settings is not active yet.
          </p>
          <ul style="padding-left: 1.5rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li><strong>Email address and account ID:</strong> Firebase uses these to identify your account. HEARTz uses the account ID to keep local settings separate for different signed-in users on the same browser.</li>
            <li><strong>Sign-in method:</strong> You can use Google or email and password. Firebase handles authentication and stores the sign-in session in browser storage on this device; HEARTz does not receive your plain-text password.</li>
          </ul>
        </section>

        <!-- 3. Local Storage and Presets -->
        <section>
          <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-brand-cream);">
            3. Local Storage (IndexedDB & LocalStorage)
          </h2>
          <p style="color: var(--text-muted);">
            Saved recipes, library entries and interface preferences use this browser's <code style="font-family: var(--font-mono); color: var(--color-brand-peach);">IndexedDB</code> and <code style="font-family: var(--font-mono); color: var(--color-brand-peach);">localStorage</code>. They do not automatically appear on another device. You can export your saved settings from the app; clearing browser data can remove local copies.
          </p>
        </section>

        <!-- 4. Cookies & Tracking Policy -->
        <section>
          <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-brand-cream);">
            4. Cookies & Tracking Technologies
          </h2>
          <p style="margin-bottom: 0.75rem; color: var(--text-muted);">
            The application uses browser storage for its sign-in session and local settings. It does not include advertising trackers:
          </p>
          <ul style="padding-left: 1.5rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li><strong>Sign-in storage:</strong> Firebase Authentication persists the session on this device so you can return without signing in again. Signing out clears the sign-in session; saved local settings remain until you remove them.</li>
            <li><strong>Site delivery:</strong> Cloudflare serves HEARTz pages and receives the network requests needed to load them.</li>
            <li><strong>No Advertising Cookies:</strong> We do not load Facebook Pixels, Google AdSense, behavioral marketing beacons, or cross-site tracking scripts.</li>
          </ul>
        </section>

        <!-- 5. Third-Party Infrastructure -->
        <section>
          <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-brand-cream);">
            5. Third-Party Infrastructure Providers
          </h2>
          <p style="margin-bottom: 0.75rem; color: var(--text-muted);">
            These services support the current website and app:
          </p>
          <ul style="padding-left: 1.5rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li><strong>Firebase Authentication:</strong> Manages HEARTz accounts and sign-in. HEARTz does not currently sync your saved recipes or upload your audio to a Firebase database.</li>
            <li><strong>Cloudflare:</strong> Provides global DNS management, SSL/TLS certificate termination, and edge caching for static assets.</li>
            <li><strong>Google Fonts:</strong> Provides typography stylesheets for consistent display across operating systems.</li>
            <li><strong>Google Forms:</strong> Opens only if you choose “Share feedback”. Responses you submit there are handled by Google Forms.</li>
          </ul>
        </section>

        <!-- 6. Account data requests -->
        <section>
          <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-brand-cream);">
            6. Your Rights & Data Deletion
          </h2>
          <p style="margin-bottom: 0.75rem; color: var(--text-muted);">
            To ask about the personal data connected with your HEARTz account, use the contact address below. Available rights depend on applicable law.
          </p>
          <ul style="padding-left: 1.5rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.5rem;">
            <li><strong>Access or correction:</strong> Contact us if you want to see or correct account information.</li>
            <li><strong>Deletion:</strong> To request deletion of your account, email <a href="mailto:contact@aitificer.com" style="color: var(--color-brand-peach); text-decoration: underline;">contact@aitificer.com</a> with the subject <em>“HEARTz account deletion”</em>. Local browser data can also be removed from your browser.</li>
          </ul>
        </section>

        <!-- 7. Contact Us -->
        <section style="border-top: 1px solid var(--border-subtle); padding-top: 2rem; margin-top: 1rem;">
          <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--color-brand-cream);">
            7. Contact & Controller Information
          </h2>
          <p style="color: var(--text-muted); margin-bottom: 1rem;">
            If you have questions, feedback, or data privacy inquiries regarding HEARTz, please contact the development and support team:
          </p>
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1.25rem; font-family: var(--font-mono); font-size: 0.9rem; color: var(--text-primary); display: flex; flex-direction: column; gap: 0.35rem;">
            <div><strong>Product:</strong> HEARTz Audio Lab (<a href="https://heartz.app" style="color: var(--color-brand-peach);">heartz.app</a>)</div>
            <div><strong>Developer / Studio:</strong> Aitificer</div>
            <div><strong>Email Support:</strong> <a href="mailto:contact@aitificer.com" style="color: var(--color-brand-peach);">contact@aitificer.com</a></div>
          </div>
        </section>

        <div style="margin-top: 1rem; display: flex; justify-content: flex-start;">
          <a href="/" class="btn btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Home</span>
          </a>
        </div>

      </div>
    </main>

    <ContactFooter />
  </body>
</html>
